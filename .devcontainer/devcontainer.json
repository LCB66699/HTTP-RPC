{
  "name": "HTTP-RPC Dev",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "dev",
  "runArgs": ["--network", "http-rpc_default"],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "golang.go",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": true,
        "cmake.buildDirectory": "${workspaceFolder}/build",
        "cmake.configureArgs": ["-DCMAKE_BUILD_TYPE=Debug"]
      }
    }
  },

  "forwardPorts": [8080],

  "postCreateCommand": "git config --global --add safe.directory /workspace && echo 'Dev container ready. cmake -B build && cmake --build build --target rpc_auth -j\$(nproc) to build.'"
}
